  "intro": "",
  "ingredients": [
    "1 луковица",
    "3 зубочка чеснока",
    "1 красный перец",
    "2 морковки порезанные кружочками",
    "2 стебля сельдерея",
    "1 чашку фасоли",
    "1 большой помидор",
    "3 веточки тимьяна",
    "бульон"
  ],
  "steps": [
    "В скороварке обжариваем лук и чеснок 1-2 минуты.",
    "Добавляем порезанный перец, морковку и сельдерей (мелко порезанный) и жарим еще 6 минут",
    "Добавляем фасол, помидоры, тимъян, лавровый лист и бульон. Перемешиваем",
    "Включаем на высокое давление на 30 минут."
  ],
